# Local development only. Copy this file to .env and replace every secret.
POSTGRES_DB=messenger
POSTGRES_USER=messenger
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

MINIO_ROOT_USER=messenger
MINIO_ROOT_PASSWORD=replace-with-a-local-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ASP.NET configuration keys. Generate independent random Base64 secrets.
Encryption__ActiveKeyVersion=1
Encryption__Keys__1=replace-with-32-byte-base64-key
BlindIndex__Key=replace-with-independent-32-byte-base64-key
ChallengeHash__Key=replace-with-independent-32-byte-base64-key
Jwt__Issuer=messenger-api
Jwt__Audience=messenger-clients
Jwt__SigningKey=replace-with-independent-32-byte-base64-key
Sms__Provider=Development
