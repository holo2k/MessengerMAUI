# Installed as /etc/messenger/messenger.env with mode 0640, root:messenger.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Messenger='Host=127.0.0.1;Port=5432;Database=messenger;Username=messenger;Password=replace-with-postgres-password;Timeout=5;Command Timeout=30'
Encryption__ActiveKeyVersion=1
Encryption__Keys__1=replace-with-32-byte-base64-key
BlindIndex__Key=replace-with-independent-32-byte-base64-key
ChallengeHash__Key=replace-with-independent-32-byte-base64-key
Jwt__Issuer=messenger-development
Jwt__Audience=messenger-clients
Jwt__SigningKey=replace-with-independent-32-byte-base64-key
Sms__Provider=Development
Minio__Endpoint=https://api.projectdomain.ru
Minio__AccessKey=replace-with-minio-user
Minio__SecretKey=replace-with-minio-password
Minio__Bucket=messenger-private
Cors__AllowedOrigins__0=https://api.projectdomain.ru
Cors__AllowedOrigins__1=https://185-56-162-174.sslip.io
ReverseProxy__KnownProxies__0=127.0.0.1
Smtp__Host=smtp.mail.ru
Smtp__Port=465
Smtp__Username=messengernotifies@mail.ru
Smtp__Password=replace-with-mail-ru-application-password
Smtp__FromAddress=messengernotifies@mail.ru
