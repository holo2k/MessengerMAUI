<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Messenger.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Messenger.Maui"
    Title="Мессенджер">

    <TabBar>
        <ShellContent x:Name="ChatsTab" Title="Чаты" Route="Chats" />
        <ShellContent x:Name="ContactsTab" Title="Контакты" Route="Contacts" />
        <ShellContent Title="Музыка" ContentTemplate="{DataTemplate local:MainPage}" Route="Music" />
        <ShellContent Title="Настройки" ContentTemplate="{DataTemplate local:MainPage}" Route="Settings" />
    </TabBar>

</Shell>
