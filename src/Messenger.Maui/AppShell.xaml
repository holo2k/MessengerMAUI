<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Messenger.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Messenger.Maui"
    Title="Мессенджер">

    <TabBar>
        <ShellContent x:Name="ChatsTab" Title="Чаты" Icon="tab_chats.png" Route="Chats" />
        <ShellContent x:Name="ContactsTab" Title="Контакты" Icon="tab_contacts.png" Route="Contacts" />
        <ShellContent x:Name="SettingsTab" Title="Настройки" Icon="tab_settings.png" Route="Settings" />
        <ShellContent x:Name="MusicTab" Title="Музыка" Icon="tab_music.png" Route="Music" />
    </TabBar>

</Shell>
