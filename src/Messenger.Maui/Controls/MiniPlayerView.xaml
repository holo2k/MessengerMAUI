<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:music="clr-namespace:Messenger.Maui.Features.Music"
             xmlns:ui="clr-namespace:Messenger.Maui.Controls"
             x:Class="Messenger.Maui.Controls.MiniPlayerView" x:DataType="music:MusicViewModel"
             HeightRequest="60">
    <Border x:Name="PlayerSurface" BackgroundColor="{StaticResource BarBackground}" Stroke="{StaticResource Separator}"
            StrokeThickness="1" StrokeShape="RoundRectangle 14">
        <Grid RowDefinitions="*,2">
            <Grid x:Name="PlayerBody" ColumnDefinitions="*,44,44" ColumnSpacing="2" Padding="8,6">
                <Grid x:Name="TrackDetails" ColumnDefinitions="36,*" ColumnSpacing="10" SemanticProperties.Description="Открыть плеер">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenPlayer" /></Grid.GestureRecognizers>
                    <ui:MusicArtworkView x:Name="Artwork" Track="{Binding CurrentTrack}" WidthRequest="36" HeightRequest="36" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label x:Name="TrackTitle" Text="{Binding CurrentTrack.Title}" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                        <Label x:Name="TrackArtist" Text="{Binding CurrentTrack.Artist}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>
                <Grid Grid.Column="1">
                    <ActivityIndicator IsRunning="{Binding IsPreparing}" IsVisible="{Binding IsPreparing}" WidthRequest="22" HeightRequest="22" />
                    <ImageButton Source="{Binding IsPlaying, Converter={StaticResource DisplayValue}, ConverterParameter=darkPlayIcon}"
                                 Clicked="OnPauseClicked" IsEnabled="{Binding CanTogglePlayback}"
                                 IsVisible="{Binding IsPreparing, Converter={StaticResource DisplayValue}, ConverterParameter=inverse}"
                                 SemanticProperties.Description="Пауза или воспроизведение" />
                </Grid>
                <ImageButton Grid.Column="2" Source="music_next.png" Clicked="OnNextClicked" IsEnabled="{Binding CanGoNext}"
                             SemanticProperties.Description="Следующий трек" />
            </Grid>
            <Grid Grid.Row="1" InputTransparent="True">
                <ProgressBar Progress="{Binding BufferedProgress}" ProgressColor="{StaticResource PrimarySoft}"
                             BackgroundColor="Transparent" HeightRequest="2" />
                <ProgressBar Progress="{Binding PlaybackProgress}" BackgroundColor="Transparent" HeightRequest="2" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
