<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Messenger.Maui.Features.Auth.LoginPage"
             Title="Вход">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
            <Label Text="Вход в мессенджер" FontSize="26" FontAttributes="Bold" />
            <Label Text="Пока SMS заменена тестовым кодом 111111." />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="{Binding CountryCode}" FontSize="18" VerticalOptions="Center" />
                <Entry Grid.Column="1" Placeholder="999 123-45-67" Keyboard="Telephone" Text="{Binding Phone}" />
            </Grid>
            <Button Text="Получить код" Clicked="OnRequestCodeClicked" />
            <Entry Placeholder="Код из SMS или email" Keyboard="Numeric" Text="{Binding Code}" />
            <Button Text="Войти" Clicked="OnLoginClicked" />
            <Button Text="Подтвердить email-код"
                    IsVisible="{Binding RequiresTwoFactor}"
                    Clicked="OnConfirmTwoFactorClicked" />
            <Button Text="Создать аккаунт" Clicked="OnOpenRegistrationClicked" />
            <Label x:Name="StatusLabel" TextColor="DarkRed" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
