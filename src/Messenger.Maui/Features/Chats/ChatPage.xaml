<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chats="clr-namespace:Messenger.Maui.Features.Chats"
             xmlns:messages="clr-namespace:Messenger.Contracts.Messages;assembly=Messenger.Contracts"
             xmlns:ui="clr-namespace:Messenger.Maui.Controls"
             x:Class="Messenger.Maui.Features.Chats.ChatPage" x:Name="ChatScreen" x:DataType="chats:ChatViewModel"
             Title="Чат" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False"
             Padding="0" SafeAreaEdges="None" BackgroundColor="{StaticResource BarBackground}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" BackgroundColor="{StaticResource BarBackground}" SafeAreaEdges="SoftInput">
        <Grid x:Name="ChatHeader" ColumnDefinitions="44,34,*,44,44" ColumnSpacing="4" Margin="0" Padding="0,2,4,2"
              SafeAreaEdges="Container,Container,Container,None" BackgroundColor="{StaticResource BarBackground}" MinimumHeightRequest="48">
            <ImageButton Source="icon_back.png" Clicked="OnBackClicked" SemanticProperties.Description="Назад к чатам" />
            <Grid Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="34,*" ColumnSpacing="4">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHeaderTapped" />
                </Grid.GestureRecognizers>
                <ui:AvatarView x:Name="HeaderAvatar" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label x:Name="ChatTitle" FontAttributes="Bold" FontSize="16" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding ConnectionStatus}" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Grid>
            <ImageButton Grid.Column="3" Source="icon_search.png" Clicked="OnToggleSearchClicked" SemanticProperties.Description="Поиск сообщений" />
            <ImageButton Grid.Column="4" Source="icon_more.png" Clicked="OnMoreClicked" SemanticProperties.Description="Действия чата" />
        </Grid>
        <ContentView x:Name="MiniPlayerHost" Grid.Row="1" IsVisible="False" />
        <Grid x:Name="SearchPanel" Grid.Row="2" ColumnDefinitions="*,Auto,Auto" BackgroundColor="{StaticResource BarBackground}" Padding="12,4" IsVisible="False">
            <Entry x:Name="SearchEntry" Placeholder="Поиск по сообщениям" ReturnType="Search" Completed="OnSearchClicked" />
            <Button Grid.Column="1" Text="Найти" Clicked="OnSearchClicked" FontSize="14" />
            <Button Grid.Column="2" Text="Сброс" Clicked="OnResetSearchClicked" FontSize="14" />
        </Grid>
        <Grid Grid.Row="3" BackgroundColor="{StaticResource ChatBackground}">
            <Image Source="chat_wallpaper.png" Aspect="AspectFill" InputTransparent="True" />
            <Grid Padding="0,8">
                <CollectionView x:Name="MessagesList" ItemsSource="{Binding Messages}" ItemsUpdatingScrollMode="KeepLastItemInView"
                                Scrolled="OnMessagesScrolled" Loaded="OnMessagesLoaded">
                    <CollectionView.EmptyView>
                        <Border BackgroundColor="#DDFFFFFF" StrokeShape="RoundRectangle 12" Padding="16,10" HorizontalOptions="Center" VerticalOptions="Center" Margin="24">
                            <Label x:Name="EmptyMessageLabel" Text="Начните общение" FontSize="14" TextColor="#52778A" HorizontalTextAlignment="Center" />
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="messages:MessageResponse">
                            <ui:MessageBubble Message="{Binding .}" CurrentUserId="{Binding Source={x:Reference ChatScreen}, Path=CurrentUserId, x:DataType=chats:ChatPage}"
                                              ReadSequence="{Binding Source={x:Reference ChatScreen}, Path=ReadSequence, x:DataType=chats:ChatPage}"
                                              Player="{Binding Source={x:Reference ChatScreen}, Path=Music, x:DataType=chats:ChatPage}"
                                              TrackOpened="OnMusicTrackOpened" TrackPlaybackRequested="OnMusicPlaybackRequested" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
        <CollectionView Grid.Row="4" ItemsSource="{Binding Media.Attachments}" HeightRequest="60" BackgroundColor="{StaticResource BarBackground}"
                        IsVisible="{Binding Media.Attachments.Count, Converter={StaticResource DisplayValue}, ConverterParameter=positive}">
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" /></CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="chats:ComposerAttachment">
                    <Border BackgroundColor="{StaticResource PrimarySoft}" StrokeShape="RoundRectangle 8" Padding="8" Margin="8,4">
                        <VerticalStackLayout WidthRequest="140" Spacing="6">
                            <Label Text="{Binding Selection.FileName}" FontSize="12" LineBreakMode="TailTruncation" />
                            <ProgressBar Progress="{Binding Progress}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid x:Name="MessageComposer" Grid.Row="5" ColumnDefinitions="44,*,44,44" BackgroundColor="{StaticResource BarBackground}"
              Margin="0" Padding="0,4,4,4" SafeAreaEdges="Container,None,Container,Container" ColumnSpacing="2">
            <ImageButton Source="icon_plus.png" Clicked="OnAttachClicked" SemanticProperties.Description="Прикрепить вложение" />
            <Border Grid.Column="1" Stroke="{StaticResource Separator}" StrokeThickness="1" StrokeShape="RoundRectangle 18" BackgroundColor="White" Padding="12,0">
                <Entry x:Name="ComposerEntry" Text="{Binding ComposerText}" Placeholder="Сообщение" MinimumHeightRequest="36" TextChanged="OnComposerChanged" />
            </Border>
            <ImageButton x:Name="CameraButton" Grid.Column="2" Source="icon_camera.png" Clicked="OnPhotoClicked" SemanticProperties.Description="Добавить фото" />
            <ImageButton x:Name="AudioButton" Grid.Column="3" Source="icon_mic.png" Clicked="OnAudioClicked" SemanticProperties.Description="Добавить аудио" />
            <ImageButton x:Name="SendButton" Grid.Column="3" Source="icon_send.png" Clicked="OnSendClicked" IsVisible="False" SemanticProperties.Description="Отправить сообщение" />
        </Grid>
    </Grid>
</ContentPage>
