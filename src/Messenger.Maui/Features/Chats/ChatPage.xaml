<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Messenger.Maui.Features.Chats.ChatPage"
             Title="Чат">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Padding="12" RowSpacing="8">
        <Label Text="{Binding ConnectionStatus}" FontSize="12" TextColor="Gray" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <Entry x:Name="SearchEntry" Placeholder="Поиск по сообщениям" />
            <Button Grid.Column="1" Text="Найти" Clicked="OnSearchClicked" />
            <Button Grid.Column="2" Text="Закреплённые" Clicked="OnPinsClicked" />
            <Button Grid.Column="3" Text="Медиа" Clicked="OnMediaClicked" />
        </Grid>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Messages}">
            <CollectionView.ItemTemplate>
                <DataTemplate><Label Text="{Binding Body}" Padding="8" /></DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <HorizontalStackLayout Grid.Row="3" Spacing="6">
            <Button Text="Файл" Clicked="OnFileClicked" />
            <Button Text="Фото" Clicked="OnPhotoClicked" />
            <Button Text="Видео" Clicked="OnVideoClicked" />
            <Button Text="Аудио" Clicked="OnAudioClicked" />
        </HorizontalStackLayout>
        <CollectionView Grid.Row="4" ItemsSource="{Binding Media.Attachments}" HeightRequest="52">
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" /></CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout WidthRequest="130">
                        <Label Text="{Binding Selection.FileName}" LineBreakMode="TailTruncation" />
                        <ProgressBar Progress="{Binding Progress}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Text="{Binding ComposerText}" Placeholder="Сообщение" />
            <Button Grid.Column="1" Text="Отправить" Clicked="OnSendClicked" />
        </Grid>
    </Grid>
</ContentPage>
