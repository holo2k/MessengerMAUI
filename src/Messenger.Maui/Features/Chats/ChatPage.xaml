<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chats="clr-namespace:Messenger.Maui.Features.Chats"
             xmlns:messages="clr-namespace:Messenger.Contracts.Messages;assembly=Messenger.Contracts"
             xmlns:ui="clr-namespace:Messenger.Maui.Controls"
             x:Class="Messenger.Maui.Features.Chats.ChatPage" x:Name="ChatScreen" x:DataType="chats:ChatViewModel"
             Title="Чат" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False"
             Padding="0" SafeAreaEdges="None" BackgroundColor="{StaticResource BarBackground}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" BackgroundColor="{StaticResource BarBackground}" SafeAreaEdges="SoftInput">
        <Grid x:Name="ChatHeader" ColumnDefinitions="44,34,*,44,44" ColumnSpacing="4" Margin="0" Padding="0,2,4,2"
              SafeAreaEdges="Container,Container,Container,None" BackgroundColor="{StaticResource BarBackground}" MinimumHeightRequest="48">
            <ImageButton Source="icon_back.png" Clicked="OnBackClicked" SemanticProperties.Description="Назад к чатам" />
            <Grid Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="34,*" ColumnSpacing="4">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHeaderTapped" />
                </Grid.GestureRecognizers>
                <ui:AvatarView x:Name="HeaderAvatar" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label x:Name="ChatTitle" FontAttributes="Bold" FontSize="16" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding ConnectionStatus}" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Grid>
            <ImageButton Grid.Column="3" Source="icon_search.png" Clicked="OnToggleSearchClicked" SemanticProperties.Description="Поиск сообщений" />
            <ImageButton Grid.Column="4" Source="icon_more.png" Clicked="OnMoreClicked" SemanticProperties.Description="Действия чата" />
        </Grid>
        <ContentView x:Name="MiniPlayerHost" Grid.Row="1" IsVisible="False" />
        <Grid x:Name="SearchPanel" Grid.Row="2" ColumnDefinitions="*,Auto,Auto" BackgroundColor="{StaticResource BarBackground}" Padding="12,4" IsVisible="False">
            <Entry x:Name="SearchEntry" Placeholder="Поиск по сообщениям" ReturnType="Search" Completed="OnSearchClicked" TextChanged="OnSearchTextChanged" />
            <Button Grid.Column="1" Text="Найти" Clicked="OnSearchClicked" FontSize="14" />
            <Button Grid.Column="2" Text="Сброс" Clicked="OnResetSearchClicked" FontSize="14" />
        </Grid>
        <Grid Grid.Row="3" BackgroundColor="{StaticResource ChatBackground}">
            <Image Source="chat_wallpaper.png" Aspect="AspectFill" InputTransparent="True" />
            <Grid Padding="0,8">
                <ui:LoadingHost x:Name="MessagesLoading" Kind="Messages">
                <CollectionView x:Name="MessagesList" ItemsSource="{Binding Messages}" ItemsUpdatingScrollMode="KeepLastItemInView"
                                Scrolled="OnMessagesScrolled" Loaded="OnMessagesLoaded">
                    <CollectionView.EmptyView>
                        <Border BackgroundColor="#DDFFFFFF" StrokeShape="RoundRectangle 12" Padding="16,10" HorizontalOptions="Center" VerticalOptions="Center" Margin="24">
                            <Label x:Name="EmptyMessageLabel" Text="Начните общение" FontSize="14" TextColor="#52778A" HorizontalTextAlignment="Center" />
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="messages:MessageResponse">
                            <ui:MessageBubble Message="{Binding .}" CurrentUserId="{Binding Source={x:Reference ChatScreen}, Path=CurrentUserId, x:DataType=chats:ChatPage}"
                                              ReadSequence="{Binding Source={x:Reference ChatScreen}, Path=ReadSequence, x:DataType=chats:ChatPage}"
                                              Player="{Binding Source={x:Reference ChatScreen}, Path=Music, x:DataType=chats:ChatPage}"
                                              TrackOpened="OnMusicTrackOpened" TrackPlaybackRequested="OnMusicPlaybackRequested"
                                              MessageActionsRequested="OnMessageActionsRequested" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </ui:LoadingHost>
            </Grid>
        </Grid>
        <CollectionView Grid.Row="4" ItemsSource="{Binding Media.Attachments}" HeightRequest="60" BackgroundColor="{StaticResource BarBackground}"
                        IsVisible="{Binding Media.Attachments.Count, Converter={StaticResource DisplayValue}, ConverterParameter=positive}">
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" /></CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="chats:ComposerAttachment">
                    <Border BackgroundColor="{StaticResource PrimarySoft}" StrokeShape="RoundRectangle 8" Padding="8" Margin="8,4">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAttachmentTapped" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                        <Grid WidthRequest="170" ColumnDefinitions="*,24" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                            <Label Text="{Binding Selection.FileName}" FontSize="12" LineBreakMode="TailTruncation" />
                            <Button Grid.Column="1" Grid.RowSpan="3" Text="✕" Padding="0" MinimumWidthRequest="24" MinimumHeightRequest="24" FontSize="13" Clicked="OnRemoveAttachmentClicked" CommandParameter="{Binding .}" SemanticProperties.Description="Убрать вложение" />
                            <ProgressBar Grid.Row="1" Progress="{Binding Progress}" />
                            <Label Grid.Row="2" Text="Повторить загрузку" FontSize="10" TextColor="{StaticResource Danger}" IsVisible="False">
                                <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding State}" Value="{x:Static chats:UploadItemState.Failed}"><Setter Property="IsVisible" Value="True" /></DataTrigger></Label.Triggers>
                            </Label>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid x:Name="MessageComposer" Grid.Row="5" ColumnDefinitions="44,*,44,44" RowDefinitions="Auto,Auto" BackgroundColor="{StaticResource BarBackground}"
              Margin="0" Padding="0,4,4,4" SafeAreaEdges="Container,None,Container,Container" ColumnSpacing="2">
            <Grid Grid.ColumnSpan="4" ColumnDefinitions="*,Auto" IsVisible="{Binding IsEditing}" Padding="12,0">
                <Label Text="Редактирование сообщения" FontSize="12" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Отмена" FontSize="12" Clicked="OnCancelEditClicked" Padding="8,0" />
            </Grid>
            <ImageButton x:Name="AttachButton" Grid.Row="1" Source="icon_plus.png" Clicked="OnAttachClicked" SemanticProperties.Description="Прикрепить вложение" IsEnabled="{Binding IsEditing, Converter={StaticResource DisplayValue}, ConverterParameter=inverse}" />
            <Border x:Name="ComposerField" Grid.Row="1" Grid.Column="1" Stroke="{StaticResource Separator}" StrokeThickness="1" StrokeShape="RoundRectangle 18" BackgroundColor="White" Padding="12,0">
                <Entry x:Name="ComposerEntry" Text="{Binding ComposerText}" Placeholder="Сообщение" MinimumHeightRequest="36" TextChanged="OnComposerChanged" />
            </Border>
            <ImageButton x:Name="CameraButton" Grid.Row="1" Grid.Column="2" Source="icon_camera.png" Clicked="OnPhotoClicked" SemanticProperties.Description="Добавить фото" IsEnabled="{Binding IsEditing, Converter={StaticResource DisplayValue}, ConverterParameter=inverse}" />
            <ui:NoteRecordButton x:Name="AudioButton" Grid.Row="1" Grid.Column="3" Source="icon_mic.png" ModeTapped="OnRecordModeTapped"
                                 HoldStarted="OnRecordHoldStarted" HoldDragged="OnRecordDragged" HoldReleased="OnRecordReleased" HoldCanceled="OnRecordCanceled"
                                 SemanticProperties.Description="Удерживайте для записи голосового; нажмите для переключения на кружочек" />
            <ImageButton x:Name="SendButton" Grid.Row="1" Grid.Column="3" Source="icon_send.png" Clicked="OnSendClicked" IsVisible="False" SemanticProperties.Description="Отправить сообщение" />
            <Grid x:Name="RecordingStatus" Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="Auto,Auto,*" Padding="16,0,8,0" ColumnSpacing="8" IsVisible="False">
                <Ellipse x:Name="RecordingIndicator" Fill="{StaticResource Danger}" WidthRequest="6" HeightRequest="6" VerticalOptions="Center" />
                <Label x:Name="RecordingTime" Grid.Column="1" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End" VerticalOptions="Center">
                    <Image Source="icon_chevron.png" Rotation="180" WidthRequest="12" HeightRequest="12" />
                    <Label Text="Сдвиньте для отмены" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
            <Grid x:Name="RecordingActions" Grid.Row="1" Grid.ColumnSpan="4" ColumnDefinitions="44,*,44,44" IsVisible="False">
                <ImageButton Source="icon_trash.png" Clicked="OnDiscardRecording" SemanticProperties.Description="Удалить запись" />
                <Label x:Name="RecordingActionTime" Grid.Column="1" Margin="8,0" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                <ImageButton x:Name="StopRecordingButton" Grid.Column="2" Source="icon_stop.png" Clicked="OnStopRecording" SemanticProperties.Description="Остановить и прослушать запись" />
                <ImageButton x:Name="SendRecordingButton" Grid.Column="3" Source="icon_send.png" Clicked="OnSendRecording" SemanticProperties.Description="Отправить запись" />
                <ActivityIndicator x:Name="RecordingSendingIndicator" Grid.Column="3" WidthRequest="22" HeightRequest="22" IsVisible="False" SemanticProperties.Description="Отправка записи" />
            </Grid>
        </Grid>
        <Grid x:Name="RecordingOverlay" Grid.Row="3" ZIndex="20" IsVisible="False" InputTransparent="True" CascadeInputTransparent="False">
            <Border x:Name="RecordingPanel" VerticalOptions="End" Margin="12" Padding="16" BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource Separator}" StrokeThickness="1" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="10">
                        <Border WidthRequest="32" HeightRequest="32" BackgroundColor="{StaticResource PrimarySoft}" StrokeShape="Ellipse">
                            <Image x:Name="RecordingModeIcon" Source="icon_mic.png" WidthRequest="18" HeightRequest="18" />
                        </Border>
                        <Label x:Name="RecordingTitle" Grid.Column="1" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                        <Label x:Name="RecordingOverlayTime" Grid.Column="2" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <Border x:Name="RecordingCameraBorder" StrokeShape="Ellipse" StrokeThickness="2" Stroke="{StaticResource PrimarySoft}"
                            WidthRequest="260" HeightRequest="260" HorizontalOptions="Center" IsVisible="False">
                        <ContentView x:Name="RecordingCameraHost" />
                    </Border>
                    <ContentView x:Name="RecordingDraftHost" HorizontalOptions="Center" />
                    <ui:NoteWaveformView x:Name="RecordingLiveWave" HeightRequest="40" />
                    <Label x:Name="RecordingHint" FontSize="12" TextColor="{StaticResource TextSecondary}" MaxLines="2" />
                    <Label x:Name="RecordingError" FontSize="12" TextColor="{StaticResource Danger}" MaxLines="4" />
                </VerticalStackLayout>
            </Border>
            <Border x:Name="RecordingLockHint" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,8,12" Padding="10,12"
                    BackgroundColor="{StaticResource White}" Stroke="{StaticResource Separator}" StrokeThickness="1" StrokeShape="RoundRectangle 20"
                    InputTransparent="True" SemanticProperties.Description="Сдвиньте вверх, чтобы закрепить запись">
                <VerticalStackLayout Spacing="10">
                    <Image Source="icon_chevron.png" Rotation="270" WidthRequest="16" HeightRequest="16" />
                    <Image Source="icon_lock.png" WidthRequest="20" HeightRequest="20" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Grid x:Name="AttachmentOverlay" Grid.RowSpan="6" ZIndex="30" IsVisible="False" SizeChanged="OnAttachmentOverlaySizeChanged">
            <BoxView Color="#66000000"><BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnAttachmentBackdropTapped" /></BoxView.GestureRecognizers></BoxView>
            <Border x:Name="AttachmentSheet" HeightRequest="480" VerticalOptions="End" BackgroundColor="{StaticResource White}" StrokeShape="RoundRectangle 24,24,0,0" StrokeThickness="0">
                <Grid SafeAreaEdges="Container,None,Container,Container"><ContentView x:Name="AttachmentPickerHost" /></Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
