<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chats="clr-namespace:Messenger.Maui.Features.Chats"
             xmlns:contracts="clr-namespace:Messenger.Contracts.Chats;assembly=Messenger.Contracts"
             xmlns:ui="clr-namespace:Messenger.Maui.Controls"
             x:Class="Messenger.Maui.Features.Chats.ChatsPage" x:Name="ChatsScreen"
             x:DataType="chats:ChatsViewModel" Title="Чаты" Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="90,*,110" HeightRequest="44" BackgroundColor="{StaticResource BarBackground}">
            <Button x:Name="EditButton" Text="Ред." HorizontalOptions="Start" Clicked="OnEditClicked" />
            <Label x:Name="SmallTitle" Grid.Column="1" Text="Чаты" Style="{StaticResource NavigationTitle}" />
            <Button x:Name="NewChatButton" Grid.Column="2" Text="Новый чат" Clicked="OnNewChatClicked" />
        </Grid>
        <Label x:Name="LargeTitle" Grid.Row="1" Text="Чаты" FontSize="34" FontAttributes="Bold" Margin="16,4,16,12" IsVisible="False" />
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="12,4,12,6">
            <Border BackgroundColor="{StaticResource SearchBackground}" StrokeShape="RoundRectangle 18">
                <HorizontalStackLayout Spacing="0" Padding="4,2">
                    <Button x:Name="AllFolderButton" Text="Все" BackgroundColor="{StaticResource PrimarySoft}" CornerRadius="16"
                            Padding="16,2" MinimumHeightRequest="32" Clicked="OnAllFolderClicked" />
                    <HorizontalStackLayout x:Name="FolderButtons" BindableLayout.ItemsSource="{Binding Folders}" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="contracts:ChatFolderResponse">
                                <Button Text="{Binding Title}" CommandParameter="{Binding .}" TextColor="{StaticResource TextSecondary}"
                                        CornerRadius="16" Padding="12,2" MinimumHeightRequest="32" Clicked="OnFolderClicked" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </Border>
        </ScrollView>
        <RefreshView x:Name="ChatRefresh" Grid.Row="3" Refreshing="OnRefreshClicked">
            <CollectionView x:Name="ChatsList" ItemsSource="{Binding VisibleChats}" SelectionMode="Multiple" SelectionChanged="OnChatSelected">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="32,70" Spacing="12">
                        <Image Source="tab_chats.png" HeightRequest="48" WidthRequest="48" Opacity="0.45" />
                        <Label Text="Здесь появятся ваши чаты" HorizontalTextAlignment="Center" FontAttributes="Bold" />
                        <Label Text="Нажмите «Новый чат», чтобы начать общение." Style="{StaticResource SecondaryLabel}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="chats:ChatListItem">
                        <Grid ColumnDefinitions="Auto,64,*,Auto,16" ColumnSpacing="0" Padding="16,10,12,0" MinimumHeightRequest="74">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected"><VisualState.Setters><Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}" /></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Stroke="{StaticResource TextTertiary}" StrokeThickness="1" StrokeShape="Ellipse" HeightRequest="22" WidthRequest="22"
                                    VerticalOptions="Center" Margin="0,0,12,10"
                                    IsVisible="{Binding Source={x:Reference ChatsScreen}, Path=IsEditing, x:DataType=chats:ChatsPage}" />
                            <ui:AvatarView Grid.Column="1" Person="{Binding Title}" AvatarObjectId="{Binding AvatarObjectId}" VerticalOptions="Start" HorizontalOptions="Start" />
                            <Grid Grid.Column="2" RowDefinitions="Auto,*,1" RowSpacing="5" Padding="0,0,0,0">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="1" Text="{Binding Preview}" TextColor="{StaticResource TextSecondary}" FontSize="14" LineBreakMode="TailTruncation" Margin="0,0,0,10" />
                                <BoxView Grid.Row="2" Style="{StaticResource SeparatorLine}" />
                            </Grid>
                            <VerticalStackLayout Grid.Column="3" Spacing="7" Margin="8,0,0,0">
                                <Label Text="{Binding DateText}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 10" Padding="6,2" HorizontalOptions="End"
                                        IsVisible="{Binding UnreadCount, Converter={StaticResource DisplayValue}, ConverterParameter=positive}">
                                    <Label Text="{Binding UnreadCount}" FontSize="11" TextColor="White" />
                                </Border>
                            </VerticalStackLayout>
                            <Image Grid.Column="4" Source="icon_chevron.png" WidthRequest="12" HeightRequest="16" Margin="0,0,0,12"
                                   IsVisible="{Binding Source={x:Reference ChatsScreen}, Path=IsEditing, x:DataType=chats:ChatsPage, Converter={StaticResource DisplayValue}, ConverterParameter=inverse}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <Grid x:Name="BulkBar" Grid.Row="4" ColumnDefinitions="*,1.3*,*" Padding="4,6" BackgroundColor="{StaticResource BarBackground}" IsVisible="False">
            <Button x:Name="ArchiveButton" Text="Архивировать" FontSize="13" Clicked="OnArchiveClicked" IsEnabled="False" />
            <Button x:Name="ReadButton" Grid.Column="1" Text="Отметить&#10;прочитанными" FontSize="13" Clicked="OnReadClicked" IsEnabled="False" />
            <Button x:Name="DeleteButton" Grid.Column="2" Text="Удалить" FontSize="13" TextColor="{StaticResource Danger}" Clicked="OnDeleteClicked" IsEnabled="False" />
        </Grid>
    </Grid>
</ContentPage>
