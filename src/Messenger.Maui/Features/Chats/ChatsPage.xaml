<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Messenger.Maui.Features.Chats.ChatsPage"
             Title="Чаты">
    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
            <Label Text="Чаты" FontSize="26" FontAttributes="Bold" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Обновить" Clicked="OnRefreshClicked" />
            <Button Grid.Column="2" Text="Новый" Clicked="OnNewChatClicked" />
            <Button Grid.Column="3" Text="Архив" Clicked="OnArchiveClicked" />
            <Button Grid.Column="4" Text="Прочитано" Clicked="OnReadClicked" />
            <Button Grid.Column="5" Text="Удалить" Clicked="OnDeleteClicked" />
        </Grid>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Folders}" ItemsLayout="HorizontalList" HeightRequest="52">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,6" Margin="2"><Label Text="{Binding Title}" /></Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <CollectionView x:Name="ChatsList" Grid.Row="2" ItemsSource="{Binding Chats}" SelectionMode="Multiple"
                        SelectionChanged="OnChatSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Chat.Title, TargetNullValue=Личный чат}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding UnreadCount}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
