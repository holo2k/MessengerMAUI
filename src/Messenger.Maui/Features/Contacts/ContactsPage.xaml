<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:contacts="clr-namespace:Messenger.Contracts.Contacts;assembly=Messenger.Contracts"
             xmlns:vm="clr-namespace:Messenger.Maui.Features.Contacts" xmlns:ui="clr-namespace:Messenger.Maui.Controls"
             x:Class="Messenger.Maui.Features.Contacts.ContactsPage" x:DataType="vm:ContactsViewModel"
             Title="Контакты" Shell.NavBarIsVisible="False" BackgroundColor="{StaticResource White}">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Padding="12,6" BackgroundColor="{StaticResource BarBackground}">
            <Border Style="{StaticResource SearchField}">
                <Grid ColumnDefinitions="*,36">
                    <Entry x:Name="SearchEntry" Placeholder="Телефон или @username" ReturnType="Search" Completed="OnSearchClicked" TextChanged="OnSearchTextChanged" MinimumHeightRequest="36" />
                    <ImageButton Grid.Column="1" Source="icon_search.png" Clicked="OnSearchClicked" HeightRequest="36" WidthRequest="36" SemanticProperties.Description="Найти контакт" />
                </Grid>
            </Border>
            <Button x:Name="CancelSearchButton" Grid.Column="1" Text="Отмена" FontSize="14" Clicked="OnCancelSearchClicked" IsVisible="False" />
        </Grid>
        <ui:LoadingHost x:Name="ContactsLoading" Grid.Row="1">
        <Grid>
        <CollectionView x:Name="ContactsList" ItemsSource="{Binding Contacts}" SelectionMode="Single" SelectionChanged="OnContactSelected">
            <CollectionView.EmptyView><Label Text="Здесь появятся ваши контакты" HorizontalTextAlignment="Center" Margin="24,60" TextColor="{StaticResource TextSecondary}" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="contacts:ContactResponse">
                    <Grid ColumnDefinitions="36,*,44" RowDefinitions="*,1" ColumnSpacing="12" BackgroundColor="White" Padding="16,8,8,0" MinimumHeightRequest="56">
                        <ui:AvatarView Person="{Binding .}" AvatarObjectId="{Binding AvatarObjectId}" WidthRequest="36" HeightRequest="36" VerticalOptions="Center" Margin="0,0,0,8" />
                        <Label Grid.Column="1" Text="{Binding ., Converter={StaticResource DisplayValue}, ConverterParameter=name}" FontSize="15" LineBreakMode="TailTruncation" VerticalOptions="Center" Margin="0,0,0,8" />
                        <ImageButton Grid.Column="2" Source="icon_info.png" CommandParameter="{Binding .}" Clicked="OnInfoClicked" SemanticProperties.Description="Информация о контакте" />
                        <BoxView Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SeparatorLine}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <CollectionView x:Name="ResultsList" ItemsSource="{Binding SearchResults}" IsVisible="False" SelectionMode="Single" SelectionChanged="OnSearchResultSelected">
            <CollectionView.EmptyView><Label Text="Пользователь не найден" HorizontalTextAlignment="Center" Margin="24,60" TextColor="{StaticResource TextSecondary}" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="contacts:UserSearchResponse">
                    <Grid ColumnDefinitions="36,*,20" Padding="16,10" ColumnSpacing="12" BackgroundColor="White">
                        <ui:AvatarView Person="{Binding .}" AvatarObjectId="{Binding AvatarObjectId}" WidthRequest="36" HeightRequest="36" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="{Binding ., Converter={StaticResource DisplayValue}, ConverterParameter=name}" FontSize="15" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Username, StringFormat='@{0}'}" Style="{StaticResource SecondaryLabel}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" Source="icon_chevron.png" HeightRequest="16" WidthRequest="16" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </Grid>
        </ui:LoadingHost>
    </Grid>
</ContentPage>
