<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Messenger.Maui.Features.Contacts.ContactsPage"
             Title="Контакты">
    <Grid RowDefinitions="Auto,Auto,*,Auto,*" Padding="12" RowSpacing="8">
        <Label Text="Контакты" FontSize="26" FontAttributes="Bold" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="SearchEntry" Placeholder="Точный телефон или username" />
            <Button Grid.Column="1" Text="Найти" Clicked="OnSearchClicked" />
        </Grid>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Contacts}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="8">
                        <Label Text="{Binding FirstName}" FontAttributes="Bold" />
                        <Label Text="{Binding Username}" FontSize="12" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label Grid.Row="3" Text="Результаты точного поиска" FontAttributes="Bold" />
        <CollectionView Grid.Row="4" ItemsSource="{Binding SearchResults}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="8">
                        <Label Text="{Binding FirstName}" FontAttributes="Bold" />
                        <Label Text="{Binding Username}" FontSize="12" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
