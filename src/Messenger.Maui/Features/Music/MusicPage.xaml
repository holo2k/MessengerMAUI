<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:music="clr-namespace:Messenger.Maui.Features.Music"
             xmlns:contracts="clr-namespace:Messenger.Contracts.Music;assembly=Messenger.Contracts"
             xmlns:ui="clr-namespace:Messenger.Maui.Controls" x:Class="Messenger.Maui.Features.Music.MusicPage"
             x:Name="MusicScreen" x:DataType="music:MusicViewModel" Title="Музыка" Shell.NavBarIsVisible="False" BackgroundColor="{StaticResource White}">

    <Grid RowDefinitions="*,Auto">
        <Grid RowDefinitions="Auto,Auto,*">
            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="*,Auto" Padding="16,12" BackgroundColor="{StaticResource BarBackground}">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Музыка" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Black}" />
                        <Label Text="Любимые треки всегда рядом" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Button x:Name="UploadButton" Grid.Column="1" Text="Загрузить" Clicked="OnUploadClicked" FontSize="13" FontAttributes="Bold"
                            BackgroundColor="#E8EDF2" TextColor="#273846" CornerRadius="20" Padding="16,8" VerticalOptions="Center" />
                </Grid>
                <VerticalStackLayout Padding="16,12" Spacing="14" BackgroundColor="{StaticResource White}">
                    <Border Style="{StaticResource SearchField}" Stroke="#E8EDF2" StrokeThickness="1">
                        <Grid ColumnDefinitions="*,36">
                            <Entry Text="{Binding SearchText}" Placeholder="Трек или исполнитель" ReturnType="Search" Completed="OnSearchClicked"
                                   TextChanged="OnSearchTextChanged" FontSize="15" MinimumHeightRequest="36" />
                            <ImageButton Grid.Column="1" Source="icon_search.png" Clicked="OnSearchClicked" WidthRequest="36" HeightRequest="36" SemanticProperties.Description="Найти музыку" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label x:Name="SectionTitle" Text="Моя музыка" FontAttributes="Bold" FontSize="20" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Слушать всё" Clicked="OnPlayAllClicked" FontSize="13" TextColor="{StaticResource Primary}"
                                BackgroundColor="Transparent" Padding="8,4" IsVisible="{Binding IsSearchLoading, Converter={StaticResource DisplayValue}, ConverterParameter=inverse}" />
                        <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsSearchLoading}" IsVisible="{Binding IsSearchLoading}" Color="{StaticResource Primary}" WidthRequest="24" HeightRequest="24" Margin="12,0" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
            <Label Grid.Row="1" Text="{Binding Status}" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="24,0,24,8"
                   IsVisible="{Binding Status, Converter={StaticResource DisplayValue}, ConverterParameter=notEmpty}" />
            <CollectionView x:Name="TracksList" Grid.Row="2" ItemsSource="{Binding Library}" SelectionMode="Single" SelectionChanged="OnTrackSelected">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="36,50" Spacing="14">
                        <Image Source="icon_music.png" HeightRequest="48" WidthRequest="48" Opacity="0.5" />
                        <Label x:Name="EmptyMusicLabel" Text="Ваша музыка начинается здесь" FontSize="19" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Найдите любимого исполнителя или загрузите аудиофайл с устройства." TextColor="{StaticResource TextSecondary}" FontSize="14" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="contracts:MusicTrackResponse">
                        <Grid ColumnDefinitions="44,*,Auto,44" ColumnSpacing="12" Padding="16,8,12,8" MinimumHeightRequest="62">
                            <Grid.BackgroundColor><MultiBinding Converter="{StaticResource DisplayValue}" ConverterParameter="libraryCurrent">
                                <Binding Path="Id" /><Binding Path="CurrentTrackId" Source="{x:Reference MusicScreen}" x:DataType="music:MusicPage" />
                            </MultiBinding></Grid.BackgroundColor>
                            <ui:MusicArtworkView Track="{Binding .}" WidthRequest="44" HeightRequest="44" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Black}" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Artist}" FontSize="13" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding DurationMs, Converter={StaticResource DisplayValue}, ConverterParameter=duration}" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                            <ImageButton Grid.Column="3" Source="icon_more.png" CommandParameter="{Binding .}" Clicked="OnTrackMenuClicked" WidthRequest="44" HeightRequest="44" SemanticProperties.Description="Действия с треком" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer><BoxView HeightRequest="12" Color="Transparent" /></CollectionView.Footer>
            </CollectionView>
        </Grid>
        <ContentView x:Name="MiniPlayerHost" Grid.Row="1" Margin="12,6" IsVisible="{Binding HasCurrentTrack}" />
    </Grid>
</ContentPage>
